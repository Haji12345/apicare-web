---
// Distinction — a short, verified place fact (e.g. "Beside a UNESCO World
// Heritage Site") in the moss regional accent, marked with a contour ring
// from the atlas. Only for facts checked against a source.
interface Props {
  text: string;
  class?: string;
}
const { text, class: className = '' } = Astro.props;
---

<p class={`inline-flex items-center gap-2 text-tiny font-medium text-moss border border-moss/40 bg-moss/[0.06] px-3 py-1.5 ${className}`}>
  <svg viewBox="0 0 16 16" class="w-3.5 h-3.5 shrink-0" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="1.2">
      <ellipse cx="8" cy="8" rx="6.6" ry="5.4" />
      <ellipse cx="8.4" cy="7.8" rx="4" ry="3.2" />
      <ellipse cx="8.7" cy="7.6" rx="1.6" ry="1.2" />
    </g>
  </svg>
  {text}
</p>
