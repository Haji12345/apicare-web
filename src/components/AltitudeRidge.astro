---
// ========================================================================
// AltitudeRidge — a village's altitude band, drawn in the atlas's linework
// ========================================================================
// A ridge profile on a fixed 0–6,000 m scale (Sikkim's forage range in our
// story), with the village's hives marked as an ochre band between the
// altitudes in src/data/honey.js. Same scale on every card, so the cards
// can be compared at a glance: Dzongu's band is tall, Zitlang's sits low.
// ========================================================================

interface Props {
  altitude: string; // e.g. '1,200 – 2,000 m'
  seed?: number;
}

const { altitude, seed = 1 } = Astro.props;

const [lo, hi] = (altitude.match(/[\d,]+/g) ?? ['0', '0']).map((n) => Number(n.replace(/,/g, '')));
const W = 240, H = 72, MAX = 6000;
const y = (m: number) => H - 4 - (Math.min(m, MAX) / MAX) * (H - 8);

// Ridge: deterministic peaks per seed, always rising well above the band.
const peak = Math.min(MAX, Math.max(hi + 2000, 3600));
const pts: string[] = [];
for (let x = 0; x <= W; x += 8) {
  const t = x / W;
  const envelope = Math.sin(Math.PI * Math.min(1, Math.max(0, (t - 0.05) / 0.9)));
  const jag = 0.78 + 0.14 * Math.sin(t * 19 + seed * 2.1) + 0.08 * Math.sin(t * 41 + seed);
  pts.push(`${x},${y(peak * envelope * jag).toFixed(1)}`);
}
---

<figure class="altitude-ridge" aria-label={`Hives at ${altitude}`}>
  <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto block" aria-hidden="true" focusable="false">
    <rect x="0" y={y(hi)} width={W} height={Math.max(2, y(lo) - y(hi))} class="fill-[#B9831C]/20" />
    <line x1="0" x2={W} y1={y(hi)} y2={y(hi)} class="stroke-[#B9831C]" stroke-width="1" stroke-dasharray="3 3" vector-effect="non-scaling-stroke" />
    <line x1="0" x2={W} y1={y(lo)} y2={y(lo)} class="stroke-[#B9831C]" stroke-width="1" stroke-dasharray="3 3" vector-effect="non-scaling-stroke" />
    <polyline points={pts.join(' ')} fill="none" class="stroke-ink" stroke-width="1.2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
    <line x1="0" x2={W} y1={H - 4} y2={H - 4} class="stroke-ink" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  </svg>
  <figcaption class="text-tiny text-ink-mute mt-2">Hives at {altitude}</figcaption>
</figure>
