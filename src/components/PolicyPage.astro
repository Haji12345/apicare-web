---
// ========================================================================
// PolicyPage — shared shell for shipping / refund / terms / privacy
// ========================================================================
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container-content max-w-reading pt-16 md:pt-22 pb-16">
    <p class="eyebrow mb-6">Policies</p>
    <h1 class="font-serif text-4xl md:text-5xl font-light tracking-tight text-ink leading-tight mb-4">{title}</h1>
    <p class="text-tiny uppercase tracking-widest text-ink-mute mb-12">Last updated {updated}</p>
    <div class="policy text-base text-ink-soft leading-relaxed">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .policy :global(h2) {
    font-family: theme('fontFamily.serif');
    font-size: 1.5rem;
    font-weight: 400;
    color: theme('colors.ink.DEFAULT');
    margin: 2.5rem 0 0.75rem;
  }
  .policy :global(p),
  .policy :global(ul) {
    margin-bottom: 1rem;
  }
  .policy :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .policy :global(li) {
    margin-bottom: 0.4rem;
  }
</style>
