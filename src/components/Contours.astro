---
// ========================================================================
// Contours — topographic linework from the Origin Atlas, as page material
// ========================================================================
// The atlas plates are drawn in fine contour lines; this carries that
// drawing into the rest of the site, generated (no images, no JS).
//
//   variant="rule"   a band of contour lines running across the page,
//                    used between sections instead of a flat colour change
//   variant="field"  nested closed contours, a hill seen from above, used
//                    as a quiet ground behind a section
//
// `seed` changes the terrain, so no two rules are identical. Colour comes
// from currentColor: set it with a text-* class on the component.
// ========================================================================

interface Props {
  variant?: 'rule' | 'field';
  seed?: number;
  class?: string;
}

const { variant = 'rule', seed = 1, class: className = '' } = Astro.props;

// Small deterministic noise: smooth, repeatable bumps for a given seed.
const wave = (x: number, k: number) =>
  Math.sin(x * 0.9 + seed * 1.7 + k) * 0.55 +
  Math.sin(x * 2.3 + seed * 0.6 + k * 1.9) * 0.3 +
  Math.sin(x * 5.1 + seed * 2.9 + k * 0.7) * 0.15;

// Catmull-Rom through points → cubic Béziers, so the lines read as drawn.
function smooth(pts: [number, number][], closed: boolean) {
  const n = pts.length;
  const at = (i: number) => pts[closed ? (i + n) % n : Math.max(0, Math.min(n - 1, i))];
  let d = `M${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
  const segs = closed ? n : n - 1;
  for (let i = 0; i < segs; i++) {
    const [p0, p1, p2, p3] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return closed ? d + 'Z' : d;
}

let viewBox: string;
let paths: string[] = [];

if (variant === 'rule') {
  // Five lines across a 1200 × 64 band, closer together where the slope is
  // steep, like contours climbing a ridge.
  viewBox = '0 0 1200 64';
  paths = [0, 1, 2, 3, 4].map((k) => {
    const pts: [number, number][] = [];
    for (let x = 0; x <= 1200; x += 60) {
      const t = x / 1200;
      const y = 10 + k * 10 + wave(t * 6, k * 0.35) * (6 + k * 1.5);
      pts.push([x, y]);
    }
    return smooth(pts, false);
  });
} else {
  // Nested rings around an off-centre summit on a 600 × 600 field.
  viewBox = '0 0 600 600';
  const cx = 360, cy = 260;
  paths = Array.from({ length: 11 }, (_, k) => {
    const r = 28 + k * 30;
    const pts: [number, number][] = [];
    for (let a = 0; a < 24; a++) {
      const th = (a / 24) * Math.PI * 2;
      const rr = r * (1 + wave(th * 1.3, k * 0.4) * 0.16 * (1 + k * 0.05));
      pts.push([cx + Math.cos(th) * rr * 1.15, cy + Math.sin(th) * rr * 0.92]);
    }
    return smooth(pts, true);
  });
}
---

<svg
  class={className}
  viewBox={viewBox}
  preserveAspectRatio={variant === 'rule' ? 'none' : 'xMidYMid slice'}
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" stroke-linecap="round">
    {paths.map((d, i) => (
      <path d={d} vector-effect="non-scaling-stroke" stroke-opacity={variant === 'field' && i % 5 === 4 ? 1 : 0.7} />
    ))}
  </g>
</svg>
