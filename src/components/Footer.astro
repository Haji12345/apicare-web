---
// ========================================================================
// Footer — minimal editorial footer with newsletter capture
// ========================================================================
import { footerNav, site, forms, policies } from '../data/site.js';

const year = new Date().getFullYear();
---

<footer class="bg-cream-deep mt-30">
  <div class="container-content py-22">

    <!-- Newsletter — stacked on phones/tablets; from lg, copy left and form
         right, the same 6 / 5 split as the home page's editorial sections -->
    <div class="grid lg:grid-cols-12 gap-x-12 lg:items-end mb-22">
      <div class="max-w-reading lg:col-span-6">
        <p class="eyebrow mb-4">Stay close</p>
        <h3 class="font-serif text-3xl md:text-4xl font-light text-ink mb-4 tracking-tight text-balance">
          One letter per harvest. Nothing more.
        </h3>
        <p class="text-base text-ink-soft mb-6">
          We write when there's something honest to say — a new village, a new harvest, a story from the hives.
        </p>
      </div>

      <form
        class="flex flex-col sm:flex-row lg:flex-wrap gap-3 max-w-md lg:max-w-none lg:col-span-5 lg:col-start-8 lg:mb-3"
        data-apicare-form="newsletter"
        data-endpoint={forms.newsletter}
        data-fallback-email={site.email}
      >
        <input
          type="email"
          name="email"
          required
          placeholder="your@email.com"
          class="flex-1 bg-transparent border-b border-ink py-2 px-1 text-sm focus:outline-none focus:border-honey transition-colors duration-300"
        />
        <!-- Hidden honeypot — bots fill this, humans don't. Formspree drops on the floor. -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <button type="submit" class="btn-ghost">
          Subscribe
        </button>
        <p class="form-status text-tiny text-ink-mute basis-full sm:basis-auto lg:basis-full" role="status" aria-live="polite"></p>
      </form>
    </div>

    <div class="hairline mb-22"></div>

    <!-- Link grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-12 mb-22">

      <!-- Brand block -->
      <div class="col-span-2 md:col-span-1">
        <img
          src="/apicare-logo.svg"
          alt={site.name}
          width="268"
          height="72"
          class="h-8 w-auto mb-3"
          loading="lazy"
        />
        <p class="text-sm text-ink-mute leading-relaxed max-w-xs">
          {site.tagline}
        </p>
      </div>

      <!-- Link groups -->
      {Object.entries(footerNav).map(([heading, links]) => (
        <div>
          <p class="eyebrow mb-5">{heading}</p>
          <ul class="space-y-3">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-ink-soft no-underline hover:text-honey transition-colors duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="hairline mb-8"></div>

    <!-- Bottom bar -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-tiny text-ink-mute">
      <p>© {year} {site.address.line1}. Made in Sikkim.</p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Policies">
        {policies.map((p) => (
          <a href={p.href} class="text-ink-mute no-underline hover:text-honey">{p.label}</a>
        ))}
        <a href="/contact" class="text-ink-mute hover:text-honey">{site.email}</a>
      </nav>
    </div>
  </div>
</footer>
