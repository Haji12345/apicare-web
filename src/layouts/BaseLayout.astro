---
// ========================================================================
// BaseLayout — wraps every page
// ========================================================================
// Handles HTML structure, head meta, font loading, header, footer,
// and the site-wide form handler. Checkout lives on /checkout.
// ========================================================================

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, analytics } from '../data/site.js';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  /** Extra schema.org objects for this page (Product, FAQPage, …) */
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title = site.name,
  description = site.description,
  ogImage = '/images/hero.jpg',
  bodyClass = '',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title === site.name ? site.homeTitle : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// Site-wide structured data: tells Google and AI assistants who ApiCare is.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.address.line1,
  url: site.url,
  logo: `${site.url}/apple-touch-icon.png`,
  description: site.description,
  email: site.email,
  telephone: site.phone,
  address: { '@type': 'PostalAddress', addressRegion: 'Sikkim', addressCountry: 'IN' },
  areaServed: 'IN',
  sameAs: Object.values(site.social),
  knowsAbout: ['Himalayan honey', 'Sikkim honey', 'Organic honey', 'Single-origin honey', 'Beekeeping', 'Honey traceability'],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  publisher: { '@id': `${site.url}/#organization` },
};
const schemas = [organization, website, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {analytics.googleSiteVerification && <meta name="google-site-verification" content={analytics.googleSiteVerification} />}
    {analytics.bingSiteVerification && <meta name="msvalidate.01" content={analytics.bingSiteVerification} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon — bee monogram from the ApiCare lockup -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Google Analytics 4 — loads only once analytics.ga4Id is set in src/data/site.js -->
    {analytics.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4Id}`}></script>
        <script is:inline define:vars={{ id: analytics.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}

    <!-- Microsoft Clarity — heatmaps + session recordings, loads only once analytics.clarityId is set -->
    {analytics.clarityId && (
      <script is:inline define:vars={{ id: analytics.clarityId }}>
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', id);
      </script>
    )}

  </head>

  <body class={bodyClass}>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const bee = document.createElement("div");
        bee.id = "bee-cursor";
        document.body.appendChild(bee);

        let mouseX = 0, mouseY = 0;
        let x = 0, y = 0;

        document.addEventListener("mousemove", (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });

        function animate() {
          x += (mouseX - x) * 0.08;
          y += (mouseY - y) * 0.08;
          bee.style.transform = `translate(${x}px, ${y}px)`;
          requestAnimationFrame(animate);
        }

        animate();
      });
    </script>
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      });

      document.querySelectorAll('[data-reveal]').forEach(el => {
        observer.observe(el);
      });
    </script>

    <!-- ====================================================================
         UNIVERSAL FORM HANDLER
         Catches every <form data-apicare-form="..."> on the site.
         - If data-endpoint is set (Formspree URL), POSTs via fetch
         - If not, opens user's mail client as a graceful fallback
         - Shows inline status in the form's .form-status element
         ==================================================================== -->
    <script>
      document.querySelectorAll('form[data-apicare-form]').forEach((form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();

          const kind = form.dataset.apicareForm; // 'contact' | 'newsletter' | 'notify'
          const endpoint = form.dataset.endpoint;
          const fallbackEmail = form.dataset.fallbackEmail || 'hello@apicare.co.in';
          const statusEl = form.querySelector('.form-status');
          const submitBtn = form.querySelector('button[type="submit"]');

          const setStatus = (text, tone = 'neutral') => {
            if (!statusEl) return;
            statusEl.textContent = text;
            statusEl.classList.remove('text-honey', 'text-ink-mute');
            statusEl.classList.add(tone === 'error' ? 'text-honey' : 'text-ink-mute');
          };

          // ---- Fallback path: no endpoint configured yet → mailto: ----
          if (!endpoint) {
            const data = new FormData(form);
            const subject = encodeURIComponent(
              kind === 'contact'   ? `[Contact] ${data.get('purpose') || 'Enquiry'}` :
              kind === 'newsletter' ? '[Newsletter] New subscriber'                  :
              kind === 'notify'    ? `[Notify] ${data.get('product') || 'product'}`  :
                                     '[ApiCare website]'
            );
            const lines = [];
            for (const [k, v] of data.entries()) {
              if (k === '_gotcha') continue;
              lines.push(`${k}: ${v}`);
            }
            const body = encodeURIComponent(lines.join('\n'));
            window.location.href = `mailto:${fallbackEmail}?subject=${subject}&body=${body}`;
            setStatus('Opening your mail app…');
            return;
          }

          // ---- Real submit: POST JSON to Formspree (or compatible) ----
          if (submitBtn) submitBtn.setAttribute('disabled', 'true');
          setStatus('Sending…');

          try {
            const data = new FormData(form);
            const res = await fetch(endpoint, {
              method: 'POST',
              body: data,
              headers: { Accept: 'application/json' },
            });

            if (res.ok) {
              form.reset();
              setStatus(
                kind === 'newsletter' ? 'Thank you — you’re on the list.' :
                kind === 'notify'    ? 'Done. We’ll write the day this harvest is ready.' :
                                       'Thank you — we’ll be in touch shortly.'
              );
            } else {
              const json = await res.json().catch(() => ({}));
              const msg = json?.errors?.[0]?.message || 'Something went wrong. Please email us directly.';
              setStatus(msg, 'error');
            }
          } catch (err) {
            setStatus('Network error. Please email us directly.', 'error');
          } finally {
            if (submitBtn) submitBtn.removeAttribute('disabled');
          }
        });
      });
    </script>
  </body>
</html>
