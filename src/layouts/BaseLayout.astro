---
// ========================================================================
// BaseLayout — wraps every page
// ========================================================================
// Handles HTML structure, head meta, font loading, header, footer,
// and the site-wide form handler. Checkout lives on /checkout.
// ========================================================================

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site, analytics } from '../data/site.js';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  /** Extra schema.org objects for this page (Product, FAQPage, …) */
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title = site.name,
  description = site.description,
  ogImage = '/images/hero.jpg',
  bodyClass = '',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title === site.name ? site.homeTitle : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// Site-wide structured data: tells Google and AI assistants who ApiCare is.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.address.line1,
  url: site.url,
  logo: `${site.url}/apple-touch-icon.png`,
  description: site.description,
  email: site.email,
  telephone: site.phone,
  address: { '@type': 'PostalAddress', addressRegion: 'Sikkim', addressCountry: 'IN' },
  areaServed: 'IN',
  sameAs: Object.values(site.social),
  knowsAbout: ['Himalayan honey', 'Sikkim honey', 'Organic honey', 'Single-origin honey', 'Beekeeping', 'Honey traceability'],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  publisher: { '@id': `${site.url}/#organization` },
};
const schemas = [organization, website, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {analytics.googleSiteVerification && <meta name="google-site-verification" content={analytics.googleSiteVerification} />}
    {analytics.bingSiteVerification && <meta name="msvalidate.01" content={analytics.bingSiteVerification} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon — bee monogram from the ApiCare lockup -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- ====================================================================
         MEASUREMENT LAYER
         1. Consent Mode v2 defaults — must run before any Google tag loads.
         2. apicareTrack() — the one function pages call to record an event.
            It pushes to window.dataLayer (read by GTM) and, while GTM is
            not set up, also sends the event straight to GA4 via gtag.
         3. Tag loading — GTM if analytics.gtmId is set, otherwise the
            hard-coded GA4 tag. Clarity loads only after consent (directly,
            or from GTM once GTM is in use).
         The tracking plan: what each event means and why it exists is in
         TRACKING-PLAN.md at the repo root.
         ==================================================================== -->
    <script is:inline define:vars={{
      ga4Id: analytics.ga4Id,
      gtmId: analytics.gtmId,
      clarityId: analytics.clarityId,
      consentRegions: analytics.consentRequiredRegions,
    }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };

      // --- 1. Consent defaults -------------------------------------------
      // The more specific (region) default wins wherever it applies.
      var denied = { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' };
      gtag('consent', 'default', Object.assign({}, denied, { region: consentRegions, wait_for_update: 500 }));
      gtag('consent', 'default', Object.assign({}, denied, { analytics_storage: 'granted' }));

      // A choice the visitor made earlier overrides the defaults.
      var CONSENT_KEY = 'apicare_consent_v1';
      var saved = null;
      try { saved = JSON.parse(localStorage.getItem(CONSENT_KEY) || 'null'); } catch (e) {}
      function consentSignals(c) {
        var ads = c.marketing ? 'granted' : 'denied';
        return {
          analytics_storage: c.analytics ? 'granted' : 'denied',
          ad_storage: ads, ad_user_data: ads, ad_personalization: ads,
        };
      }
      if (saved) gtag('consent', 'update', consentSignals(saved));

      // --- 2. Event helper ------------------------------------------------
      // apicareTrack('view_item', { ecommerce: { currency, value, items } })
      // Never pass names, emails, phones or addresses: GA4 forbids
      // personal data, and orders join to GA4 on transaction_id only.
      window.apicareTrack = function (name, params) {
        params = params || {};
        if (params.ecommerce) dataLayer.push({ ecommerce: null }); // clear the previous ecommerce object
        dataLayer.push(Object.assign({ event: name }, params));
        if (!gtmId && ga4Id) {
          var flat = Object.assign({}, params.ecommerce || {}, params);
          delete flat.ecommerce;
          gtag('event', name, flat);
        }
      };

      // --- 3. Clarity, only with analytics consent (non-GTM path) --------
      window.apicareLoadClarity = function () {
        if (gtmId || !clarityId || window.clarity) return;
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', clarityId);
      };
      window.apicareConsent = {
        key: CONSENT_KEY,
        saved: saved,
        apply: function (choice) {
          var record = { analytics: !!choice.analytics, marketing: !!choice.marketing, ts: new Date().toISOString() };
          try { localStorage.setItem(CONSENT_KEY, JSON.stringify(record)); } catch (e) {}
          this.saved = record;
          gtag('consent', 'update', consentSignals(record));
          dataLayer.push({ event: 'consent_update', consent_analytics: record.analytics, consent_marketing: record.marketing });
          if (record.analytics) window.apicareLoadClarity();
        },
      };
      if (saved && saved.analytics) window.apicareLoadClarity();

      // --- 4. Load Google tags --------------------------------------------
      if (gtmId) {
        dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var g = document.createElement('script');
        g.async = true;
        g.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
        document.head.appendChild(g);
      } else if (ga4Id) {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', ga4Id);
      }
    </script>

  </head>

  <body class={bodyClass}>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <ConsentBanner />

    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      });

      document.querySelectorAll('[data-reveal]').forEach(el => {
        observer.observe(el);
      });
    </script>

    <!-- ====================================================================
         UNIVERSAL FORM HANDLER
         Catches every <form data-apicare-form="..."> on the site.
         - If data-endpoint is set (Formspree URL), POSTs via fetch
         - If not, opens user's mail client as a graceful fallback
         - Shows inline status in the form's .form-status element
         ==================================================================== -->
    <script>
      document.querySelectorAll('form[data-apicare-form]').forEach((form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();

          const kind = form.dataset.apicareForm; // 'contact' | 'newsletter' | 'notify'
          const endpoint = form.dataset.endpoint;
          const fallbackEmail = form.dataset.fallbackEmail || 'hello@apicare.co.in';
          const statusEl = form.querySelector('.form-status');
          const submitBtn = form.querySelector('button[type="submit"]');

          const setStatus = (text, tone = 'neutral') => {
            if (!statusEl) return;
            statusEl.textContent = text;
            statusEl.classList.remove('text-honey', 'text-ink-mute');
            statusEl.classList.add(tone === 'error' ? 'text-honey' : 'text-ink-mute');
          };

          // ---- Fallback path: no endpoint configured yet → mailto: ----
          if (!endpoint) {
            const data = new FormData(form);
            const subject = encodeURIComponent(
              kind === 'contact'   ? `[Contact] ${data.get('purpose') || 'Enquiry'}` :
              kind === 'newsletter' ? '[Newsletter] New subscriber'                  :
              kind === 'notify'    ? `[Notify] ${data.get('product') || 'product'}`  :
                                     '[ApiCare website]'
            );
            const lines = [];
            for (const [k, v] of data.entries()) {
              if (k === '_gotcha') continue;
              lines.push(`${k}: ${v}`);
            }
            const body = encodeURIComponent(lines.join('\n'));
            window.location.href = `mailto:${fallbackEmail}?subject=${subject}&body=${body}`;
            setStatus('Opening your mail app…');
            return;
          }

          // ---- Real submit: POST JSON to Formspree (or compatible) ----
          if (submitBtn) submitBtn.setAttribute('disabled', 'true');
          setStatus('Sending…');

          try {
            const data = new FormData(form);
            const res = await fetch(endpoint, {
              method: 'POST',
              body: data,
              headers: { Accept: 'application/json' },
            });

            if (res.ok) {
              form.reset();
              // Lead captured: the 'lead_type' parameter tells contact,
              // newsletter and notify-me apart in GA4. No personal data.
              (window as any).apicareTrack?.('generate_lead', { lead_type: kind });
              setStatus(
                kind === 'newsletter' ? 'Thank you — you’re on the list.' :
                kind === 'notify'    ? 'Done. We’ll write the day this harvest is ready.' :
                                       'Thank you — we’ll be in touch shortly.'
              );
            } else {
              const json = await res.json().catch(() => ({}));
              const msg = json?.errors?.[0]?.message || 'Something went wrong. Please email us directly.';
              setStatus(msg, 'error');
            }
          } catch (err) {
            setStatus('Network error. Please email us directly.', 'error');
          } finally {
            if (submitBtn) submitBtn.removeAttribute('disabled');
          }
        });
      });
    </script>
  </body>
</html>
